<Window x:Class="VoiceWithoutBorders.Features.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:overlay="clr-namespace:VoiceWithoutBorders.Features.Overlay"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=overlay:OverlayViewModel}"
        Title="Voice Without Borders overlay"
        ThemeMode="None"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Grid Opacity="{Binding Fade}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                        <Setter Property="Cursor" Value="SizeAll" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Grid.LayoutTransform>
        <!-- Background on its own layer, so its opacity setting leaves the indicators solid. -->
        <Border x:Name="Pill" CornerRadius="14" BorderThickness="1" Opacity="{Binding BackgroundOpacity}">
            <Border.Style>
                <!-- Brushes are setters, not attributes: a local value would beat the unlocked trigger. -->
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1B1E26" />
                    <Setter Property="BorderBrush" Value="#33FFFFFF" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                            <Setter Property="Background" Value="#163A40" />
                            <Setter Property="BorderBrush" Value="#26C6DA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <!-- Centred in case Windows holds the window to its minimum size (136x39 px), taller than the pill. -->
        <!-- A lost link replaces the indicators with a warning of exactly their size, so the pill never moves. -->
        <Grid Margin="11,6" VerticalAlignment="Center">
            <ItemsControl x:Name="IndicatorRow" ItemsSource="{Binding Indicators}" HorizontalAlignment="Center">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LinkProblem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Orientation" Value="Horizontal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVertical}" Value="True">
                                            <Setter Property="Orientation" Value="Vertical" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type overlay:StreamIndicator}">
                        <!-- Fixed cell heights keep the icon, the arrow and the bars on one centre line. -->
                        <StackPanel x:Name="Root" Orientation="Horizontal" Margin="5,0" Height="20">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                       Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                       VerticalAlignment="Center" Text="{Binding Glyph}" />
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" Foreground="{Binding Accent}"
                                       Height="8" LineHeight="8" LineStackingStrategy="BlockLineHeight"
                                       VerticalAlignment="Center" Margin="2,0,5,0" Text="{Binding DirectionGlyph}" />
                            <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Accent}" Height="{Binding Bar0}" />
                            <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Accent}" Height="{Binding Bar1}" />
                            <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Accent}" Height="{Binding Bar2}" />
                            <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Accent}" Height="{Binding Bar3}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                <Setter TargetName="Root" Property="Margin" Value="2,1" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Viewbox Width="{Binding ActualWidth, ElementName=IndicatorRow}" Height="{Binding ActualHeight, ElementName=IndicatorRow}"
                     StretchDirection="DownOnly">
                <Viewbox.Style>
                    <Style TargetType="Viewbox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LinkProblem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FFB74D"
                               VerticalAlignment="Center" Margin="0,0,6,0" Text="&#xE7BA;" />
                    <TextBlock FontSize="12" Foreground="#FFB74D" VerticalAlignment="Center" Text="{Binding LinkProblem}" />
                </StackPanel>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
