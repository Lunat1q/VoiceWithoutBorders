<Window x:Class="VoiceWithoutBorders.Features.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:overlay="clr-namespace:VoiceWithoutBorders.Features.Overlay"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=overlay:OverlayViewModel}"
        Title="Voice Without Borders overlay"
        ThemeMode="None"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border CornerRadius="14" Padding="10,5" Background="#D91B1E26" BorderBrush="#33FFFFFF" BorderThickness="1">
        <ItemsControl ItemsSource="{Binding Indicators}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type overlay:StreamIndicator}">
                    <StackPanel x:Name="Root" Orientation="Horizontal" Margin="5,0" Height="20">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                   VerticalAlignment="Center" Text="{Binding Glyph}" />
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" Foreground="{Binding Accent}"
                                   VerticalAlignment="Center" Margin="2,0,5,0" Text="{Binding DirectionGlyph}" />
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Accent}" Height="{Binding Bar0}" />
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Accent}" Height="{Binding Bar1}" />
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Accent}" Height="{Binding Bar2}" />
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Accent}" Height="{Binding Bar3}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
