<Window x:Class="VoiceWithoutBorders.Features.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:main="clr-namespace:VoiceWithoutBorders.Features.Main"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=main:MainViewModel}"
        Title="Voice Without Borders"
        Width="600"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="Warning" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FFFFA000" />
            <Setter Property="Background" Value="#33FFA000" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="DisplayMemberPath" Value="Name" />
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <Border Style="{StaticResource Warning}" Margin="0,0,0,12"
                Visibility="{Binding NoOutputDevices, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock TextWrapping="Wrap">
                This computer has no playback devices, so it cannot play or relay anything it receives.
                Install a virtual cable such as
                <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="OpenLink">VB-CABLE</Hyperlink>,
                then press Refresh devices.
            </TextBlock>
        </Border>

        <StackPanel IsEnabled="{Binding IsIdle}">
            <GroupBox Header="Other computer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="_Computer name or IP" Target="{Binding ElementName=PeerHostBox}" />
                    <TextBox x:Name="PeerHostBox" Grid.Column="1" Text="{Binding PeerHost, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Grid.Row="1" Content="_UDP port" Target="{Binding ElementName=PortBox}" />
                    <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Port}" />

                    <Label Grid.Row="2" Content="Shared _key" Target="{Binding ElementName=SharedKeyBox}" />
                    <DockPanel Grid.Row="2" Grid.Column="1">
                        <Button DockPanel.Dock="Right" Content="_New" MinWidth="0" Margin="8,4,0,4" Padding="12,0"
                                ToolTip="Generate a new random key" Command="{Binding NewSharedKeyCommand}" />
                        <TextBox x:Name="SharedKeyBox" FontFamily="Consolas"
                                 Text="{Binding SharedKey, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                               Text="Use the same port and key (16+ characters) on both computers: type this key on the other one." />
                </Grid>
            </GroupBox>

            <GroupBox Header="Send to the other computer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="_My microphone" Target="{Binding ElementName=MicCaptureBox}" />
                    <ComboBox x:Name="MicCaptureBox" Grid.Column="1" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding MicCapture}" />

                    <Label Grid.Row="1" Content="_Sound playing on" Target="{Binding ElementName=SystemCaptureBox}" />
                    <ComboBox x:Name="SystemCaptureBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SystemCapture}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Play what the other computer sends">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="Play its microphone i_nto" Target="{Binding ElementName=MicPlaybackBox}" />
                    <ComboBox x:Name="MicPlaybackBox" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding MicPlayback}" />

                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Style="{StaticResource Hint}">
                            Playback devices on purpose: audio can only be played into a device. Pick the playback side
                            of a virtual cable ("CABLE Input" from
                            <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="OpenLink">VB-CABLE</Hyperlink>);
                            apps here then choose its recording side ("CABLE Output") as their microphone.
                        </TextBlock>
                        <Border Style="{StaticResource Warning}"
                                Visibility="{Binding MicPlaybackIsAudible, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock TextWrapping="Wrap">
                                This plays the other computer's microphone out loud, where this computer's own microphone
                                can pick it up again. To use it as a microphone here, pick a virtual cable.
                                No cable listed? Install
                                <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="OpenLink">VB-CABLE</Hyperlink>,
                                then press Refresh devices.
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <Label Grid.Row="2" Content="Play its s_ound on" Target="{Binding ElementName=SystemPlaybackBox}" />
                    <ComboBox x:Name="SystemPlaybackBox" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SystemPlayback}" />

                    <Label Grid.Row="3" Content="Max _latency (ms)" Target="{Binding ElementName=LatencyBox}" />
                    <TextBox x:Name="LatencyBox" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding MaxLatencyMs}" />
                </Grid>
            </GroupBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Refresh devices" Command="{Binding RefreshDevicesCommand}" />
            <Button Content="S_tart" Command="{Binding StartCommand}" IsDefault="True" />
            <Button Content="Sto_p" Command="{Binding StopCommand}" />
        </StackPanel>

        <TextBlock Margin="0,12,0,0" Text="{Binding Status}" TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0" Text="{Binding Stats}" Style="{StaticResource Hint}" />
    </StackPanel>
</Window>
