<Window x:Class="VoiceWithoutBorders.Features.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:main="clr-namespace:VoiceWithoutBorders.Features.Main"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=main:MainViewModel}"
        Title="Voice Without Borders"
        Width="600"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="DisplayMemberPath" Value="Name" />
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <StackPanel IsEnabled="{Binding IsIdle}">
            <GroupBox Header="Other computer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="_Computer name or IP" Target="{Binding ElementName=PeerHostBox}" />
                    <TextBox x:Name="PeerHostBox" Grid.Column="1" Text="{Binding PeerHost, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Grid.Row="1" Content="_UDP port" Target="{Binding ElementName=PortBox}" />
                    <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Port}" />

                    <Label Grid.Row="2" Content="Shared _key" Target="{Binding ElementName=SharedKeyBox}" />
                    <PasswordBox x:Name="SharedKeyBox" Grid.Row="2" Grid.Column="1" />

                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                               Text="Use the same port and key (16+ characters) on both computers." />
                </Grid>
            </GroupBox>

            <GroupBox Header="Send to the other computer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="_My microphone" Target="{Binding ElementName=MicCaptureBox}" />
                    <ComboBox x:Name="MicCaptureBox" Grid.Column="1" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding MicCapture}" />

                    <Label Grid.Row="1" Content="_Sound playing on" Target="{Binding ElementName=SystemCaptureBox}" />
                    <ComboBox x:Name="SystemCaptureBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SystemCapture}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Play what the other computer sends">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="Its microphone o_n" Target="{Binding ElementName=MicPlaybackBox}" />
                    <ComboBox x:Name="MicPlaybackBox" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding MicPlayback}" />

                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}"
                               Text="Pick a virtual cable input (for example &quot;CABLE Input&quot;) so apps here can record it as a microphone." />

                    <Label Grid.Row="2" Content="Its s_ound on" Target="{Binding ElementName=SystemPlaybackBox}" />
                    <ComboBox x:Name="SystemPlaybackBox" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SystemPlayback}" />

                    <Label Grid.Row="3" Content="Max _latency (ms)" Target="{Binding ElementName=LatencyBox}" />
                    <TextBox x:Name="LatencyBox" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding MaxLatencyMs}" />
                </Grid>
            </GroupBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Refresh devices" Command="{Binding RefreshDevicesCommand}" />
            <Button Content="S_tart" Command="{Binding StartCommand}" IsDefault="True" />
            <Button Content="Sto_p" Command="{Binding StopCommand}" />
        </StackPanel>

        <TextBlock Margin="0,12,0,0" Text="{Binding Status}" TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0" Text="{Binding Stats}" Style="{StaticResource Hint}" />
    </StackPanel>
</Window>
