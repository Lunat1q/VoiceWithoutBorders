<Window x:Class="VoiceWithoutBorders.Features.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:main="clr-namespace:VoiceWithoutBorders.Features.Main"
        xmlns:tabs="clr-namespace:VoiceWithoutBorders.Features.Main.Tabs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=main:MainViewModel}"
        Title="Voice Without Borders"
        Width="620"
        Height="640"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="12">
        <!-- Everyday use: status, start/stop, live toggles. -->
        <TabItem Header="Stream">
            <tabs:StreamTab />
        </TabItem>

        <!-- One-time setup, split so no tab needs scrolling; locked while streaming. -->
        <TabItem Header="Connection">
            <tabs:ConnectionTab />
        </TabItem>

        <TabItem Header="Devices">
            <tabs:DevicesTab />
        </TabItem>

        <TabItem Header="Hotkeys &amp; overlay">
            <tabs:HotkeysTab />
        </TabItem>
    </TabControl>
</Window>
