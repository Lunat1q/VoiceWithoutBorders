<UserControl x:Class="VoiceWithoutBorders.Features.Main.Tabs.NotificationsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:main="clr-namespace:VoiceWithoutBorders.Features.Main"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=main:MainViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="/VoiceWithoutBorders;component/Features/Main/MainStyles.xaml" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource TabPage}">
        <StackPanel>
            <GroupBox Header="Tray notifications">
                <StackPanel>
                    <CheckBox Content="_Show notifications" IsChecked="{Binding NotificationsEnabled}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Pop-ups from the tray icon when the link to the other computer changes. They never show while this window is in front, since the status is right here." />

                    <StackPanel Margin="24,0,0,0" IsEnabled="{Binding NotificationsEnabled}">
                        <CheckBox Content="_Connected, or connected again" IsChecked="{Binding NotifyConnected}" />
                        <CheckBox Content="_Lost the connection" IsChecked="{Binding NotifyLost}" />
                        <CheckBox Content="Other computer uses a different shared _key" IsChecked="{Binding NotifyKeyMismatch}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
