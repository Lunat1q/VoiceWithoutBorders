<UserControl x:Class="VoiceWithoutBorders.Features.Main.Tabs.ConnectionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:main="clr-namespace:VoiceWithoutBorders.Features.Main"
             xmlns:hotkeys="clr-namespace:VoiceWithoutBorders.Features.Hotkeys"
             xmlns:streaming="clr-namespace:VoiceWithoutBorders.Features.Streaming"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=main:MainViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="/VoiceWithoutBorders;component/Features/Main/MainStyles.xaml" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource TabPage}">
        <StackPanel>
            <Border Style="{StaticResource Warning}" Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock TextWrapping="Wrap" Text="Stop streaming to change the connection." />
            </Border>

            <StackPanel IsEnabled="{Binding IsIdle}">
                <GroupBox Header="Other computer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Content="_Computer name or IP" Target="{Binding ElementName=PeerHostBox}" />
                        <TextBox x:Name="PeerHostBox" Grid.Column="1" Text="{Binding PeerHost, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Grid.Row="1" Content="_UDP port" Target="{Binding ElementName=PortBox}" />
                        <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Port}" />

                        <Label Grid.Row="2" Content="Shared _key" Target="{Binding ElementName=SharedKeyBox}" />
                        <DockPanel Grid.Row="2" Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="_New" MinWidth="0" Margin="8,4,0,4" Padding="12,0"
                                    ToolTip="Generate a new random key" Command="{Binding NewSharedKeyCommand}" />
                            <TextBox x:Name="SharedKeyBox" FontFamily="Consolas" Text="{Binding SharedKey, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                                   Text="Use the same port and key (16+ characters) on both computers: type this key on the other one." />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Advanced">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Content="Max _latency (ms)" Target="{Binding ElementName=LatencyBox}" />
                        <TextBox x:Name="LatencyBox" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding MaxLatencyMs}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}"
                                   Text="Lower feels snappier; raise it if you hear crackles on Wi-Fi." />
                    </Grid>
                </GroupBox>
            </StackPanel>

            <GroupBox Header="Startup">
                <StackPanel>
                    <CheckBox Content="Start with _Windows (in the tray)" IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Margin="0,8,0,0" Content="Then c_onnect by itself with these settings" IsChecked="{Binding AutoConnect}"
                              IsEnabled="{Binding StartWithWindows}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
