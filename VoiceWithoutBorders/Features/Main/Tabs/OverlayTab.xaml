<UserControl x:Class="VoiceWithoutBorders.Features.Main.Tabs.OverlayTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:main="clr-namespace:VoiceWithoutBorders.Features.Main"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=main:MainViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="/VoiceWithoutBorders;component/Features/Main/MainStyles.xaml" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource TabPage}">
        <StackPanel>
            <GroupBox Header="Overlay">
                <StackPanel>
                    <CheckBox Content="Show overlay _while streaming" IsChecked="{Binding ShowOverlay}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="R_eset position" Command="{Binding ResetOverlayPositionCommand}" />
                        <CheckBox Content="_Unlock to move it" IsChecked="{Binding OverlayUnlocked}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="While unlocked the overlay stays visible so you can drag it anywhere and preview the settings below. Lock it again to make it click-through; the spot is remembered." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Look">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.ColumnSpan="3" Content="Stack the indicators in a _column" IsChecked="{Binding OverlayVertical}" />

                    <Label Grid.Row="1" Content="_Size" Target="{Binding ElementName=ScaleSlider}" />
                    <Slider x:Name="ScaleSlider" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                            Minimum="0.75" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding OverlayScale}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Shortcut}" Text="{Binding OverlayScale, StringFormat={}{0:P0}}" />

                    <Label Grid.Row="2" Content="_Background" Target="{Binding ElementName=OpacitySlider}" />
                    <Slider x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding OverlayOpacity}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Shortcut}" Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" />

                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                               Text="0 % leaves only the icons and bars, for a pill that hides less of a game." />

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                        <CheckBox Content="_Hide when quiet" IsChecked="{Binding OverlayHideWhenQuiet}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Fades out after 5 seconds without sound and comes back on sound, a mute change or a lost connection." />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
