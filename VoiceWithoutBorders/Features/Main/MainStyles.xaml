<!-- Styles shared by the main window's tabs. -->
<ResourceDictionary
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:main="clr-namespace:VoiceWithoutBorders.Features.Main"
                    xmlns:hotkeys="clr-namespace:VoiceWithoutBorders.Features.Hotkeys"
                    xmlns:streaming="clr-namespace:VoiceWithoutBorders.Features.Streaming">
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    <SolidColorBrush x:Key="OkBrush" Color="#2EA043" />
    <SolidColorBrush x:Key="WaitingBrush" Color="#FFA000" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E5534B" />
    <SolidColorBrush x:Key="IdleBrush" Color="#808080" Opacity="0.65" />
    <Style x:Key="Dot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FlowDot" TargetType="Ellipse" BasedOn="{StaticResource Dot}">
        <Setter Property="Fill" Value="{StaticResource IdleBrush}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="Margin" Value="0,4,8,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style TargetType="hotkeys:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="DisplayMemberPath" Value="Name" />
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Shortcut" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style x:Key="Warning" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#FFFFA000" />
        <Setter Property="Background" Value="#33FFA000" />
    </Style>
    <Style x:Key="Notice" TargetType="Border" BasedOn="{StaticResource Warning}">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="TabPage" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="4,12,8,4" />
    </Style>
</ResourceDictionary>
